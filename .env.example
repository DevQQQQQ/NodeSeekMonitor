# NodeSeek Monitor 配置模板
#
# 用法：cp .env.example .env  然后填入真实值。
# .env 已被 .gitignore 排除，绝不会进入仓库或镜像。

# ---- RSS ----
# NodeSeek 全站最新帖 RSS 地址
RSS_URL=https://rss.nodeseek.com/

# ---- 轮询 ----
# 轮询间隔（秒）。RSS 只返回最近约 20 条，发帖高峰可缩短到 10
POLL_INTERVAL_SECONDS=30

# ---- 监控关键词 ----
# 逗号分隔，大小写不敏感，匹配标题 + 摘要。
# 示例：CloudCone,DMIT,搬瓦工
KEYWORDS=CloudCone

# ---- Telegram ----
# TELEGRAM_BOT_TOKEN：找 @BotFather 创建机器人获取
# TELEGRAM_CHAT_ID  ：找 @userinfobot 查询你自己的 chat id
# 两项都留空时进入 monitor-only 模式：只记录日志，不推送
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- 存储 ----
# 容器内路径。如需修改，请同步调整 docker-compose.yml 的 volumes 挂载
DATABASE_PATH=/app/data/nodeseek.db

# ---- 日志 ----
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
